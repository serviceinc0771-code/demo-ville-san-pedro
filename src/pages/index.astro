---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SectionHeading from '../components/SectionHeading.astro';
import DemoBadge from '../components/DemoBadge.astro';
---

<BaseLayout
  title="San-Pédro — Port, lagune & plages | Côte d'Ivoire"
  description="Découvrez San-Pédro : énergie du port, plages de Monogaga, marchés et culture du sud-ouest ivoirien. Démo marketing."
>
  <Header slot="header" />

  <!-- HERO -->
  <section class="relative isolate min-h-[92vh] overflow-hidden bg-atlantique text-surface">
    <div class="absolute inset-0 -z-10 overflow-hidden" aria-hidden="true">
      <img
        src="/images/hero-coast.svg"
        alt=""
        class="ken-burns h-full w-full object-cover"
        width="1600"
        height="900"
        decoding="async"
      />
      <div class="absolute inset-0 bg-gradient-to-b from-atlantique/55 via-atlantique/40 to-atlantique/85"></div>
    </div>

    <div class="mx-auto flex min-h-[92vh] max-w-6xl flex-col justify-end px-4 pb-20 pt-28 sm:px-6 md:justify-center md:pb-28 md:pt-32">
      <p class="reveal inline-flex w-fit items-center gap-2 rounded-full border border-white/20 bg-white/10 px-3 py-1 text-xs font-semibold uppercase tracking-[0.16em] text-surface/90 backdrop-blur-sm">
        Sud-ouest · Atlantique
      </p>
      <h1 class="reveal mt-5 max-w-3xl font-display text-[2.6rem] font-semibold leading-[1.08] tracking-tight sm:text-5xl md:text-6xl">
        San-Pédro,<br />
        <span class="text-fond">là où le port rencontre la plage</span>
      </h1>
      <p class="reveal mt-5 max-w-xl text-base leading-relaxed text-surface/80 sm:text-lg">
        Ville cacao et Atlantique : lagune calme le matin, marchés animés, sable de Monogaga
        et horizon de cargos. Une invitation à sentir le rythme local.
      </p>
      <div class="reveal mt-8 flex flex-wrap gap-3">
        <a
          href="/decouvrir"
          class="inline-flex items-center justify-center rounded-full bg-cta px-6 py-3 text-sm font-semibold text-surface shadow-lg shadow-atlantique/30 transition hover:bg-cta-hover"
        >
          Découvrir la ville
        </a>
        <a
          href="/pratiques"
          class="inline-flex items-center justify-center rounded-full border border-white/30 bg-white/10 px-6 py-3 text-sm font-semibold text-surface backdrop-blur-sm transition hover:bg-white/20"
        >
          Infos pratiques
        </a>
      </div>
    </div>

    <div class="wave-divider absolute bottom-0 left-0 right-0" aria-hidden="true">
      <img src="/images/wave.svg" alt="" class="w-full" width="1440" height="80" />
    </div>
  </section>

  <!-- PILIERS -->
  <section class="bg-fond px-4 py-16 sm:px-6 sm:py-20">
    <SectionHeading
      eyebrow="L’esprit du lieu"
      title="Port, lagune, plages"
      lead="Trois respirations qui font San-Pédro : le travail du quai, l’eau douce de la lagune, et le large ouvert vers Monogaga."
    />

    <div class="mx-auto mt-12 grid max-w-6xl gap-5 sm:grid-cols-3">
      {
        [
          {
            title: 'Énergie du port',
            text: 'Cacao, bois, cargos et bruits de grue — le pouls économique du sud-ouest, visible dès l’arrivée en ville.',
            tone: 'bg-atlantique text-surface',
            label: 'Commerce',
          },
          {
            title: 'Lagune & villages',
            text: 'Matins brumeux, pirogues, pêche locale : une autre San-Pédro, plus lente, collée à l’eau.',
            tone: 'bg-lagune text-surface',
            label: 'Eau douce',
          },
          {
            title: 'Monogaga vibe',
            text: 'Cocotiers, vagues et fin d’après-midi dorée — le trait d’union entre ville et Atlantique.',
            tone: 'bg-culture text-surface',
            label: 'Littoral',
          },
        ].map((card) => (
          <article class:list={['reveal card-lift rounded-3xl p-6 sm:p-7', card.tone]}>
            <p class="text-[0.68rem] font-semibold uppercase tracking-[0.16em] opacity-70">{card.label}</p>
            <h3 class="mt-3 font-display text-2xl font-semibold text-inherit">{card.title}</h3>
            <p class="mt-3 text-sm leading-relaxed opacity-85">{card.text}</p>
          </article>
        ))
      }
    </div>
  </section>

  <!-- BANDEAU CULTURE -->
  <section class="border-y border-bord bg-surface px-4 py-16 sm:px-6 sm:py-20">
    <div class="mx-auto grid max-w-6xl items-center gap-10 md:grid-cols-2">
      <div class="reveal">
        <DemoBadge />
        <h2 class="mt-4 font-display text-3xl font-semibold tracking-tight sm:text-4xl">
          Marchés, saveurs, rencontres
        </h2>
        <p class="mt-4 text-base leading-relaxed text-texte/75">
          Entre le marché central et les petites échoppes du bord de route : igname, poisson grillé,
          attieke, fruits de saison. San-Pédro se goûte autant qu’elle se regarde.
        </p>
        <ul class="mt-6 space-y-3 text-sm text-texte/80">
          <li class="flex gap-3">
            <span class="mt-1.5 h-2 w-2 shrink-0 rounded-full bg-cta" aria-hidden="true"></span>
            Ambiance portuaire sans folklore forcé
          </li>
          <li class="flex gap-3">
            <span class="mt-1.5 h-2 w-2 shrink-0 rounded-full bg-lagune" aria-hidden="true"></span>
            Hospitalité du sud-ouest ivoirien
          </li>
          <li class="flex gap-3">
            <span class="mt-1.5 h-2 w-2 shrink-0 rounded-full bg-culture" aria-hidden="true"></span>
            Contenu crédible, clairement marqué démo
          </li>
        </ul>
        <a
          href="/decouvrir"
          class="mt-8 inline-flex rounded-full bg-atlantique px-5 py-2.5 text-sm font-semibold text-surface transition hover:bg-atlantique/90"
        >
          Explorer culture & lieux
        </a>
      </div>

      <div class="reveal grid grid-cols-2 gap-3 sm:gap-4">
        <div class="rounded-3xl bg-atlantique p-5 text-surface sm:p-6">
          <p class="font-display text-4xl font-semibold">2ᵉ</p>
          <p class="mt-2 text-sm text-surface/75">port du pays — rôle cacao & bois <span class="opacity-70">(repère général)</span></p>
        </div>
        <div class="mt-6 rounded-3xl bg-lagune p-5 text-surface sm:p-6">
          <p class="font-display text-4xl font-semibold">∞</p>
          <p class="mt-2 text-sm text-surface/75">horizons Atlantique vers Monogaga & au-delà</p>
        </div>
        <div class="rounded-3xl border border-bord bg-fond p-5 sm:col-span-2 sm:p-6">
          <p class="font-display text-xl font-semibold text-atlantique">« On vient pour le port, on reste pour la mer. »</p>
          <p class="mt-2 text-sm text-texte/65">Formule d’ambiance — citation démo, non attribuée.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="bg-fond px-4 py-16 sm:px-6 sm:py-20">
    <div class="reveal mx-auto max-w-4xl overflow-hidden rounded-[2rem] bg-atlantique px-6 py-12 text-center text-surface sm:px-12">
      <p class="text-xs font-semibold uppercase tracking-[0.18em] text-surface/60">Prêt à venir ?</p>
      <h2 class="mt-3 font-display text-3xl font-semibold sm:text-4xl">Infos utiles avant le départ</h2>
      <p class="mx-auto mt-3 max-w-xl text-sm leading-relaxed text-surface/75 sm:text-base">
        Accès, climat, bonnes pratiques voyageur & local — sans liste d’avis inventés ni labels fantômes.
      </p>
      <div class="mt-8 flex flex-wrap justify-center gap-3">
        <a href="/pratiques" class="rounded-full bg-cta px-6 py-3 text-sm font-semibold text-surface transition hover:bg-cta-hover">
          Voir les pratiques
        </a>
        <a href="/contact" class="rounded-full border border-white/25 px-6 py-3 text-sm font-semibold text-surface transition hover:bg-white/10">
          Nous écrire
        </a>
      </div>
    </div>
  </section>

  <Footer slot="footer" />
</BaseLayout>
