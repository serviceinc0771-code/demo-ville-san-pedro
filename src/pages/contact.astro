---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import DemoBadge from '../components/DemoBadge.astro';
---

<BaseLayout
  title="Contact — San-Pédro démo"
  description="Contactez l’équipe démo du site San-Pédro. Formulaire illustratif, sans envoi réel."
  solidHeader
>
  <Header slot="header" />

  <section class="bg-atlantique px-4 pb-16 pt-28 text-surface sm:px-6 sm:pb-20 sm:pt-32">
    <div class="mx-auto max-w-3xl">
      <DemoBadge class="border-white/20 bg-white/10 text-surface" />
      <h1 class="mt-4 font-display text-4xl font-semibold tracking-tight text-surface sm:text-5xl">
        Contact
      </h1>
      <p class="mt-4 text-base leading-relaxed text-surface/75 sm:text-lg">
        Une question sur cette démo marketing / culture ? Écrivez-nous via le formulaire ci-dessous.
      </p>
    </div>
  </section>

  <section class="bg-fond px-4 py-16 sm:px-6 sm:py-20">
    <div class="mx-auto grid max-w-6xl gap-10 lg:grid-cols-[1fr_1.15fr]">
      <aside class="reveal space-y-6">
        <div class="rounded-3xl border border-bord bg-surface p-6 sm:p-7">
          <h2 class="font-display text-xl font-semibold text-atlantique">À propos de ce site</h2>
          <p class="mt-3 text-sm leading-relaxed text-texte/75">
            Projet statique de démonstration (Astro + Tailwind) pour présenter San-Pédro
            avec une identité littorale et culturelle — pas un site institutionnel officiel.
          </p>
        </div>
        <div class="rounded-3xl bg-lagune p-6 text-surface sm:p-7">
          <p class="text-xs font-semibold uppercase tracking-[0.16em] text-surface/65">Coordonnées démo</p>
          <ul class="mt-4 space-y-3 text-sm text-surface/90">
            <li>
              <span class="block text-surface/55">Courriel</span>
              hello@sanpedro-demo.ci
            </li>
            <li>
              <span class="block text-surface/55">Lieu évoqué</span>
              San-Pédro, Côte d’Ivoire
            </li>
          </ul>
          <p class="mt-5 text-xs text-surface/60">Adresses fictives à des fins d’illustration.</p>
        </div>
      </aside>

      <div class="reveal rounded-[1.75rem] border border-bord bg-surface p-6 sm:p-8">
        <form class="space-y-5" method="get" action="/contact" id="contact-form">
          <div class="grid gap-5 sm:grid-cols-2">
            <label class="block text-sm font-medium text-texte">
              Prénom
              <input
                type="text"
                name="prenom"
                required
                autocomplete="given-name"
                class="mt-1.5 w-full rounded-xl border border-bord bg-fond px-3.5 py-2.5 text-sm text-texte outline-none ring-lagune/30 transition focus:border-lagune focus:ring-2"
              />
            </label>
            <label class="block text-sm font-medium text-texte">
              Nom
              <input
                type="text"
                name="nom"
                required
                autocomplete="family-name"
                class="mt-1.5 w-full rounded-xl border border-bord bg-fond px-3.5 py-2.5 text-sm text-texte outline-none ring-lagune/30 transition focus:border-lagune focus:ring-2"
              />
            </label>
          </div>

          <label class="block text-sm font-medium text-texte">
            E-mail
            <input
              type="email"
              name="email"
              required
              autocomplete="email"
              class="mt-1.5 w-full rounded-xl border border-bord bg-fond px-3.5 py-2.5 text-sm text-texte outline-none ring-lagune/30 transition focus:border-lagune focus:ring-2"
            />
          </label>

          <label class="block text-sm font-medium text-texte">
            Sujet
            <select
              name="sujet"
              class="mt-1.5 w-full rounded-xl border border-bord bg-fond px-3.5 py-2.5 text-sm text-texte outline-none ring-lagune/30 transition focus:border-lagune focus:ring-2"
            >
              <option>Question générale</option>
              <option>Partenariat / presse (démo)</option>
              <option>Signaler une erreur de contenu</option>
            </select>
          </label>

          <label class="block text-sm font-medium text-texte">
            Message
            <textarea
              name="message"
              required
              rows="5"
              class="mt-1.5 w-full resize-y rounded-xl border border-bord bg-fond px-3.5 py-2.5 text-sm text-texte outline-none ring-lagune/30 transition focus:border-lagune focus:ring-2"
            ></textarea>
          </label>

          <p class="text-xs leading-relaxed text-texte/55">
            Envoi simulé côté navigateur uniquement — aucune donnée n’est transmise à un serveur.
          </p>

          <button
            type="submit"
            class="inline-flex w-full items-center justify-center rounded-full bg-cta px-6 py-3 text-sm font-semibold text-surface transition hover:bg-cta-hover sm:w-auto"
          >
            Envoyer le message
          </button>

          <p
            id="form-success"
            class="hidden rounded-xl border border-lagune/30 bg-lagune/10 px-4 py-3 text-sm text-lagune"
            role="status"
          >
            Merci — message enregistré localement pour la démo. Rien n’a été envoyé en ligne.
          </p>
        </form>
      </div>
    </div>
  </section>

  <Footer slot="footer" />
</BaseLayout>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const success = document.getElementById('form-success');
  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    success?.classList.remove('hidden');
    form.reset();
  });
</script>
