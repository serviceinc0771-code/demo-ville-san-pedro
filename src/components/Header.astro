---
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const links = [
  { href: '/', label: 'Accueil' },
  { href: '/decouvrir', label: 'Découvrir' },
  { href: '/pratiques', label: 'Pratiques' },
  { href: '/contact', label: 'Contact' },
];

function isActive(href: string) {
  if (href === '/') return path === '/';
  return path.startsWith(href);
}
---

<header class="site-header">
  <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-4 py-3.5 sm:px-6">
    <a href="/" class="group flex items-center gap-2.5 no-underline">
      <span
        class="flex h-9 w-9 items-center justify-center rounded-full bg-cta/90 text-sm font-semibold text-surface shadow-sm ring-1 ring-white/20"
        aria-hidden="true"
      >
        SP
      </span>
      <span class="leading-tight">
        <span class="block font-display text-[1.05rem] font-semibold tracking-tight text-inherit">
          San-Pédro
        </span>
        <span class="block text-[0.68rem] font-medium uppercase tracking-[0.14em] text-inherit/70">
          Côte d'Ivoire
        </span>
      </span>
    </a>

    <nav class="hidden items-center gap-1 md:flex" aria-label="Navigation principale">
      {
        links.map((l) => (
          <a
            href={l.href}
            class:list={[
              'rounded-full px-3.5 py-1.5 text-sm font-medium transition-colors',
              isActive(l.href)
                ? 'bg-white/15 text-surface'
                : 'text-surface/80 hover:bg-white/10 hover:text-surface',
            ]}
            aria-current={isActive(l.href) ? 'page' : undefined}
          >
            {l.label}
          </a>
        ))
      }
    </nav>

    <details class="relative md:hidden">
      <summary
        class="flex h-10 w-10 cursor-pointer list-none items-center justify-center rounded-full bg-white/10 text-surface ring-1 ring-white/20 [&::-webkit-details-marker]:hidden"
        aria-label="Ouvrir le menu"
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M4 7h16M4 12h16M4 17h16" stroke-linecap="round" />
        </svg>
      </summary>
      <div
        class="absolute right-0 mt-2 w-52 overflow-hidden rounded-2xl border border-bord/40 bg-atlantique/95 p-2 shadow-xl backdrop-blur-md"
      >
        {
          links.map((l) => (
            <a
              href={l.href}
              class:list={[
                'block rounded-xl px-3 py-2.5 text-sm font-medium',
                isActive(l.href) ? 'bg-white/15 text-surface' : 'text-surface/85 hover:bg-white/10',
              ]}
              aria-current={isActive(l.href) ? 'page' : undefined}
            >
              {l.label}
            </a>
          ))
        }
      </div>
    </details>
  </div>
</header>
